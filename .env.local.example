# =============================================================================
# PROJECT AHRI / FRIDAY CLIENT (.env.local.example)
# =============================================================================
# Supabase Client (Anon Key for Realtime Subscriptions & Queries)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Firebase Client SDK (Web Auth + Web Push FCM)
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Express AI Brain & WebSocket URL
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/live
